{
  "name": "localship",
  "version": "0.0.0",
  "description": "Local-first, agent-native localization for apps. Your repo is the translation system; your model is the translator.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "localship": "./dist/cli.js",
    "l10n": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "localization",
    "l10n",
    "i18n",
    "android",
    "ios",
    "xcstrings",
    "mcp",
    "agent",
    "skills"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "commander": "^15.0.0",
    "ignore": "^7.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
